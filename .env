# Enable wetterdienst fsspec disk cache (DWD data).
# When enabled, stale cache is auto-cleared and retried once.
#
# true  = cache enabled (faster repeated requests, ~0.3s vs ~7s cold)
# false = cache disabled (always fresh from DWD)
DWD_CACHE=true

# Logging level (DEBUG, INFO, WARNING, ERROR).
# WARNING = errors only, INFO = all activity (recommended for dev).
LOG_LEVEL=INFO

# MQTT push (optional — disabled when MQTT_BROKER is empty).
# Background timer fetches weather every MQTT_INTERVAL seconds and publishes
# the merged result via MQTT. Default: 600s (10min, matches MosMix cache TTL).
# MQTT_BROKER=
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=weather-hub
# MQTT_TOPIC=weather-hub/state
MQTT_LAT=49.87
MQTT_LON=8.93
MQTT_INTERVAL=600